# Salin file ini jadi .env lalu sesuaikan.

# Port API backend
PORT=4000

# Secret untuk menandatangani JWT.
# Ganti dengan nilai acak panjang, contoh: openssl rand -hex 32
JWT_SECRET=ganti-dengan-secret-acak-panjang

# ---------------------------------------------------------------
# Sinkronisasi foto ke backend VPS (opsional).
# Isi bila ingin foto dslrBooth otomatis terdorong ke VPS.
# ---------------------------------------------------------------

# URL publik untuk link galeri & QR (Cloudflare tunnel VPS).
PUBLIC_BASE_URL=https://shares.kira2memories.web.id

# URL backend VPS tempat foto disinkronkan.
VPS_BASE_URL=https://shares.kira2memories.web.id

# Akun di backend VPS (dibuat lewat /api/user/register atau seed).
VPS_EMAIL=demo@local
VPS_PASSWORD=demo1234
